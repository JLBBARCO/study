// Declarações iniciais de variáveis
var servidores = []
var condicao_loop_principal = verdadeiro
// Título do programa
escreva("\n----------------------------")
escreva("\n---Analista de Servidores---")
escreva("\n----------------------------")
// Início da lógica do programa
enquanto (condicao_loop_principal == verdadeiro) {
    escreva("\nDigite o nome do servidor (ou 0 para sair): ")
    var nome_servidor = leia()
    se (nome_servidor == "0") {
        condicao_loop_principal = falso
        escreva("Saindo do programa...\n")
    } senão {
        se (nome_servidor != "") {
            var servidor = {"id": servidores.tamanho() + 1, "nome": nome_servidor, "ping": [], "ping_medio": 0}
            var condicao_loop_ping = verdadeiro
            enquanto (condicao_loop_principal == verdadeiro e condicao_loop_ping == verdadeiro) {
                escreva("Digite o valor do ping (ou 0 para encerrar o cadastro de pings): ")
                var valor_ping = leia()
                se (valor_ping == "0") {
                    condicao_loop_ping = falso
                    continua
                }
                tente {
                    valor_ping = numero(valor_ping)
} pegue (erro) {
                    escreva("Valor de ping inválido. Tente novamente.\n")
                    continua
                }
                servidor["ping"].adicionar(valor_ping)
            }
            // Cálculo da média do ping
            var media_ping = 0
            var total_pings = servidor["ping"].tamanho()
            se (total_pings > 0) {
                para var i = 0; i < total_pings; i = i + 1 {
                    media_ping = media_ping + (servidor["ping"][i] * 1)
                }
                media_ping = media_ping / total_pings
                servidor["ping_medio"] = media_ping
            }
            servidores.adicionar(servidor)
            escreva("Servidor " + nome_servidor + " cadastrado com sucesso!\n")
        } senão {
            escreva("Nome do servidor inválido. Tente novamente.\n")
        }
    }
}
// Loop de ordenação dos servidores pelo ping médio (do maior para o menor)
var _esta_ordenado = falso
enquanto (_esta_ordenado == falso) {
    _esta_ordenado = verdadeiro
    para var i = 0; i < servidores.tamanho() - 1; i = i + 1 {
        se (servidores[i]["ping_medio"] < servidores[i + 1]["ping_medio"]) {
            var temp = servidores[i]
            servidores[i] = servidores[i + 1]
            servidores[i + 1] = temp
            _esta_ordenado = falso
        }
    }
}
// Exibição do resultado final
escreva("\n---- Lista de Servidores Cadastrados ----")
escreva("\nServidores em alerta (ping médio >= 100ms):")
para var i = 0; i < servidores.tamanho(); i = i + 1 {
    se (servidores[i]["ping_medio"] >= 100) {
        escreva("ID: " + texto(servidores[i]["id"]) + " | Servidor: " + servidores[i]["nome"] + " | Quantidade de Pings: " + texto(servidores[i]["ping"].tamanho()) + " | Ping Medio: " + texto(servidores[i]["ping_medio"]) + "ms")
    }
}
escreva("\nTodos os Servidores:")
para var i = 0; i < servidores.tamanho(); i = i + 1 {
    escreva("ID: " + texto(servidores[i]["id"]) + " | Servidor: " + servidores[i]["nome"] + " | Quantidade de Pings: " + texto(servidores[i]["ping"].tamanho()) + " | Ping Medio: " + texto(servidores[i]["ping_medio"]) + "ms")
}
escreva("\nTotal de servidores: " + texto(servidores.tamanho()))
