algoritmo ""
var
    numero1: real
    numero2: real
    soma: real
    diferente: real
    produto: real
    quociente: real
inicio
    escreva("Digite o primeiro número: ")
        leia(numero1)
    escreva("Digite o segundo número: ")
        leia(numero2)
    soma <- numero1 + numero2
    diferente <- numero1 - numero2
    produto <- numero1 * numero2
    quociente <- numero1 / numero2
    escreval("")
    escreval("Soma: ", soma)
    escreval("Diferença: ", diferente)
    escreval("Produto: ", produto)
    escreval("Quociente: ", quociente)

fimalgoritmo